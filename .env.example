# Copy to .env.local. Everything is optional for local development.

# Postgres (Neon, Supabase…). Leave empty to use the embedded PGlite database in .data/pglite.
DATABASE_URL=

# GitHub personal access token (classic, no scope: https://github.com/settings/tokens/new):
# 5,000 API calls/hour instead of 60, and star counts refreshed every minute.
GITHUB_TOKEN=

# Sessions. Required in production: generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public URL of the app (production), e.g. https://trendtracker.example.com
BETTER_AUTH_URL=

# Google sign-in (popup). Create an OAuth client "Web application" in Google Cloud Console,
# authorised redirect URI: http://localhost:3000/api/auth/callback/google (and your production URL).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mail sign-in codes. Any SMTP server works. Gmail: enable 2-step verification, create an
# app password at https://myaccount.google.com/apppasswords, then:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com  SMTP_PASSWORD=<16-letter app password>
# Without SMTP (or RESEND_API_KEY), codes are only printed in the server console (development).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=
# Sender shown in the e-mail (defaults to SMTP_USER).
MAIL_FROM=

# Enables the "Analyse" card on repository pages (Claude).
ANTHROPIC_API_KEY=

# Protects POST /api/ingest. Required in production; optional in development.
CRON_SECRET=

# Built-in scheduler for long-running servers (next dev / next start). 0 disables it.
INGEST_INTERVAL_MINUTES=5
# Star counts of the repositories on screen, refreshed this often (needs GITHUB_TOKEN). 0 disables it.
LIVE_INTERVAL_SECONDS=60

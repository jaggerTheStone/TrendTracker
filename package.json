{
  "name": "trendtracker",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time radar of rising GitHub repositories: live star counts, momentum scores, trend radar and buzz from YouTube and Hacker News.",
  "keywords": [
    "github",
    "github-trending",
    "trending",
    "open-source",
    "radar",
    "analytics",
    "nextjs",
    "react",
    "typescript",
    "drizzle-orm",
    "postgresql",
    "server-sent-events"
  ],
  "homepage": "https://github.com/jaggerTheStone/TrendTracker#readme",
  "bugs": {
    "url": "https://github.com/jaggerTheStone/TrendTracker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaggerTheStone/TrendTracker.git"
  },
  "license": "MIT",
  "author": "jaggerTheStone (https://github.com/jaggerTheStone)",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "ingest": "tsx scripts/ingest.mts",
    "format": "prettier --write .",
    "clean": "node -e \"for (const d of ['.next', 'tsconfig.tsbuildinfo']) require('fs').rmSync(d, { recursive: true, force: true })\"",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@electric-sql/pglite": "^0.5.15",
    "better-auth": "^1.7.16",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.0",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "postgres": "^4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
